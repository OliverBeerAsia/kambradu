{
  "name": "kambradu",
  "version": "0.5.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/build.mjs",
    "build:next": "next build",
    "start": "node scripts/serve-static.mjs",
    "type-check": "tsc --noEmit",
    "test:smoke": "npm run build && playwright test",
    "test:unit": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test tests/local-data.test.ts tests/validate-seed.test.mjs tests/languages.test.mjs",
    "test:rules": "npx --yes firebase-tools@15.24.0 emulators:exec --only firestore \"node --test tests/firestore-rules.test.mjs\"",
    "seed:firestore": "node scripts/seed-firestore.mjs",
    "firebase:emulators": "npx --yes firebase-tools@15.24.0 emulators:start --only auth,firestore,storage,hosting"
  },
  "dependencies": {
    "firebase": "12.13.0",
    "lucide-react": "0.468.0",
    "next": "15.5.21",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.1",
    "@playwright/test": "1.60.0",
    "@types/node": "22.19.19",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "firebase-admin": "13.10.0",
    "typescript": "5.9.3"
  }
}
